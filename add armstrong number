import java.util.Scanner;

public class armstrong {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        System.out.println("give a no.");
        int a=sc.nextInt();
        for(int i=1;i<=a;i++){
            int sum=0;
            for(int j=i;j>0;j=j/10) {
                int rem = j % 10;
                sum = sum + (rem * rem * rem);
            }
            if(sum==i){
                System.out.println(i);
                }
            else{
                continue;
            }
        }
    }
}
